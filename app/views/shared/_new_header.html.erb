<header class="new-header fixed top-0 left-0 z-[999] flex w-full justify-center bg-primary transition-[background-color,box-shadow] duration-300 ease-in"
        data-controller="header"
        data-header-target="root">
  <div class="custom-wrapper w-full max-w-[1300px]">
    <nav class="navbar flex items-center justify-between bg-transparent px-20 py-4 max-[1104px]:px-20">
      <div class="logo mr-6 flex items-center">
        <%= link_to root_path do %>
          <%= image_tag "syftet-logo-white.webp", alt: "ANZARA GLOBAL Logo", class: "block h-10 w-auto transition-transform duration-300 hover:scale-105" %>
        <% end %>
      </div>

      <button class="hamburger z-[1001] hidden cursor-pointer border-none bg-none p-2.5 max-[1104px]:block"
              data-action="click->header#toggleMobile"
              data-header-target="hamburger"
              aria-label="Toggle menu">
        <span class="my-[5px] block h-[3px] w-[25px] bg-white transition-all duration-300"></span>
        <span class="my-[5px] block h-[3px] w-[25px] bg-white transition-all duration-300"></span>
        <span class="my-[5px] block h-[3px] w-[25px] bg-white transition-all duration-300"></span>
      </button>

      <div class="navbar-container flex items-center gap-6
                  max-[1104px]:fixed max-[1104px]:top-20 max-[1104px]:right-[-100%] max-[1104px]:z-[1000]
                  max-[1104px]:h-screen max-[1104px]:w-full max-[1104px]:max-w-[600px] max-[1104px]:flex-col
                  max-[1104px]:items-start max-[1104px]:overflow-y-auto max-[1104px]:bg-secondary
                  max-[1104px]:px-4 max-[1104px]:pb-4 max-[1104px]:transition-[right] max-[1104px]:duration-300
                  max-[1104px]:gap-[1.4rem]
                  data-[open=true]:max-[1104px]:right-0"
           data-header-target="navContainer">
        <ul class="nav-links flex list-none items-center gap-6
                   max-[1104px]:w-full max-[1104px]:flex-col max-[1104px]:items-start max-[1104px]:gap-4">

          <li class="mega-dropdown relative max-[1104px]:w-full" data-controller="dropdown">
            <button type="button"
                    class="dropdown-toggle cursor-pointer border-none bg-none text-sm font-bold text-white hover:text-hover-text max-[1104px]:w-full max-[1104px]:text-left"
                    data-action="click->dropdown#toggle">Services</button>
            <div class="mega-menu fixed top-[70px] left-0 right-0 z-[1000] mx-auto max-h-[80vh] w-[calc(100%-10rem)] max-w-[calc(1300px-10rem)] cursor-default justify-between gap-8 overflow-y-auto bg-white p-8 text-black shadow-[0_4px_20px_rgba(0,0,0,0.1)]
                        max-[1104px]:static max-[1104px]:m-0 max-[1104px]:w-full max-[1104px]:p-4 max-[1104px]:shadow-none
                        max-[768px]:flex-col">
              <div class="menu-columns grid w-full grid-cols-3 gap-x-8 gap-y-4 max-[1104px]:grid-cols-1">
                <div class="column !w-max">
                  <h4 class="mb-2 pb-[5px] text-base text-black">Core Development Services →</h4>
                  <%= link_to "Custom Software Development", custom_software_development_company_path, class: "mega-menu-link" %>
                  <%= link_to "Desktop Application Development", desktop_application_development_company_path, class: "mega-menu-link" %>
                  <%#= link_to "Mobile App Development", mobile_app_development_company_path, class: "mega-menu-link" %>
                  <%= link_to "Web Application Development", web_development_company_path, class: "mega-menu-link" %>
                </div>
                <div class="column !w-max">
                  <h4 class="mb-2 pb-[5px] text-base text-black">Design, UX & Product Services →</h4>
                  <%= link_to "UI/UX Design & Product Design Services", ui_ux_design_path, class: "mega-menu-link" %>
                  <%= link_to "E-Commerce Solution", e_commerce_solution_path, class: "mega-menu-link" %>
                  <%= link_to "Data Management & Business Analysis", data_management_and_business_analysis_path, class: "mega-menu-link" %>
                  <%= link_to "Business Automation Solutions", business_automation_solutions_path, class: "mega-menu-link" %>
                </div>
                <div class="column !w-max">
                  <h4 class="mb-2 pb-[5px] text-base text-black">Advanced Tech & Support Services →</h4>
                  <%= link_to "AI, ML & DL", ai_ml_and_dl_path, class: "mega-menu-link" %>
                  <%= link_to "IoT Service", iot_service_path, class: "mega-menu-link" %>
                  <%#= link_to "Software Maintenance & Support", website_maintenance_services_company_path, class: "mega-menu-link" %>
                  <%= link_to "Testing & Quality Assurance (QA)", testing_quality_assurance_path, class: "mega-menu-link" %>
                </div>
              </div>
            </div>
          </li>

          <li class="mega-dropdown relative max-[1104px]:w-full" data-controller="dropdown">
            <button type="button"
                    class="dropdown-toggle cursor-pointer border-none bg-none text-sm font-bold text-white hover:text-hover-text max-[1104px]:w-full max-[1104px]:text-left"
                    data-action="click->dropdown#toggle">Clients</button>
            <div class="mega-menu fixed top-[70px] left-0 right-0 z-[1000] mx-auto max-h-[80vh] w-[calc(100%-10rem)] max-w-[calc(1300px-10rem)] cursor-default justify-between gap-8 overflow-y-auto bg-white p-8 text-black shadow-[0_4px_20px_rgba(0,0,0,0.1)]
                        max-[1104px]:static max-[1104px]:m-0 max-[1104px]:w-full max-[1104px]:p-4 max-[1104px]:shadow-none
                        max-[768px]:flex-col">
              <div class="menu-columns grid w-full grid-cols-3 gap-x-8 gap-y-4 max-[1104px]:grid-cols-1">
                <% [
                  ["🕌 Islamic Platform →", ["Daily Islam"]],
                  ["🧩 Platform / Infrastructure →", ["ShareTribe", "Mindstack"]],
                  ["🛠️ Repair & Logistics →", ["FileTracker", "Qijcorepair"]],
                  ["🛡️ Govt. / Security →", ["BNV NAVY", "Essential Intelligence Services"]],
                  ["❓ Needs Clarification →", ["iNwe", "EmerLoop"]],
                  ["✈️ Migration & Welcome →", ["Welcome2Australia", "My Welcome App"]],
                  ["🎧 Entertainment & Media →", ["Pianome", "EPK Solution - New Artist Relase", "Trip Ticket"]],
                  ["🏦 FinTech & Banking →", ["Islami Bank Bangladesh Limited", "Modhumoti Bank", "Lienex POS"]],
                  ["🎓 EdTech & Learning →", ["Instructory", "Khude Coder", "Digital School", "My School Bag"]],
                  ["🏢 SaaS & Enterprise →", ["TRACPro", "FileTracker", "Rank Up", "Silverback", "One Touch"]],
                  ["🛒 E-Commerce & Rentals →", ["Lobster Tail Seafood", "Myoldtimer", "Beeprentals", "Armoiar", "Boxgiver"]]
                ].each do |heading, items| %>
                  <div class="column !w-max">
                    <h4 class="mb-2 pb-[5px] text-base text-black"><%= heading %></h4>
                    <% items.each do |item| %>
                      <span class="non-link mb-2 block cursor-default pl-6 text-[15px] text-[#1c3d5b]"><%= item %></span>
                    <% end %>
                  </div>
                <% end %>

                <div class="column !w-max pt-4">
                  <h4 class="mb-2 pb-[5px] text-base text-black">🔍 Explore All Clients →</h4>
                  <%= link_to "View Full Client Portfolio", clients_path,
                              class: "contact-btn cursor-pointer rounded-[5px] border-none bg-btn-green px-4 py-1 text-sm font-bold text-white no-underline ml-6 pl-4" %>
                </div>
              </div>
            </div>
          </li>

          <li class="text-sm font-bold text-white max-[1104px]:w-full">
            <%= link_to "Portfolio", portfolios_path, class: "text-inherit no-underline transition-colors duration-300 hover:text-hover-text" %>
          </li>
          <li class="text-sm font-bold text-white max-[1104px]:w-full">
            <%= link_to "How We Work", how_we_work_path, class: "text-inherit no-underline transition-colors duration-300 hover:text-hover-text" %>
          </li>
<!--          <li class="text-sm font-bold text-white max-[1104px]:w-full">-->
            <%#= link_to "Events", events_path, class: "text-inherit no-underline transition-colors duration-300 hover:text-hover-text" %>
<!--          </li>-->
          <li class="text-sm font-bold text-white max-[1104px]:w-full">
            <%= link_to "Careers", career_path, class: "text-inherit no-underline transition-colors duration-300 hover:text-hover-text" %>
          </li>

          <li class="text-sm font-bold text-white max-[1104px]:w-full">
            <%= link_to "About Us", about_us_path, class: "text-inherit no-underline transition-colors duration-300 hover:text-hover-text" %>
          </li>

        </ul>

        <%= link_to "Contact Us", contact_us_path,
                    class: "contact-btn cursor-pointer rounded-[5px] border-none bg-btn-green px-4 py-1 text-sm font-bold text-white no-underline" %>
      </div>
    </nav>
  </div>
</header>

