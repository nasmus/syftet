<%# Shared "Let's work together" CTA banner used at the bottom of every service page %>
<section class="flex justify-center bg-light-gray py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="rounded-2xl bg-gradient-to-r from-primary to-secondary p-10 text-center text-white md:p-16">
      <h2 class="text-3xl font-bold md:text-4xl">Let's work Together</h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-white/80 md:text-lg">
        We are excited to partner with you on your next project. Reach out today and our team will get back to you promptly with the next steps.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <%= link_to "Start here", contact_us_path,
                    class: "inline-block rounded-md bg-btn-green px-6 py-3 text-sm font-bold text-white no-underline transition-transform duration-300 hover:scale-105" %>
        <%= link_to "Contact Us", contact_us_path,
                    class: "inline-block rounded-md border border-white/30 bg-white/5 px-6 py-3 text-sm font-bold text-white no-underline transition-colors duration-300 hover:bg-white/10" %>
      </div>
    </div>
  </div>
</section>
