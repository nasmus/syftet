<% content_for :title       do %>About Us | ANZARA GLOBAL<% end %>
<% content_for :meta_title  do %>About Us | ANZARA GLOBAL<% end %>
<% content_for :meta_description do %>ANZARA GLOBAL LTD — a UK-registered private limited company building software products and services across Bangladesh, Australia and the UK.<% end %>

<%= render "shared/service_hero",
           eyebrow: "About Us",
           title: "Who We Are",
           copy: "ANZARA GLOBAL LTD is a registered UK company building software products and services that help businesses grow. From a single registered office in London to delivery teams across three time zones, we ship work that lasts." %>

<section class="flex justify-center bg-white py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="mb-14 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-primary md:text-4xl">
        Company Information
        <span class="absolute -bottom-3 left-1/2 h-[5px] w-[100px] -translate-x-1/2 rounded bg-accent"></span>
      </h2>
      <p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed text-soft-text md:text-lg">
        Public company-registration details for ANZARA GLOBAL LTD.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border-t-4 border-accent bg-light-gray p-6 shadow-soft">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-xl text-white">
          <i class="fas fa-location-dot"></i>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wider text-soft-text">Registered Office</p>
        <p class="mt-2 text-sm font-bold leading-relaxed text-primary">
          Barkat House, Suite 9,<br>
          116-118 Finchley Road,<br>
          London, United Kingdom,<br>
          NW3 5HT
        </p>
      </div>

      <div class="rounded-2xl border-t-4 border-btn-green bg-light-gray p-6 shadow-soft">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-btn-green text-xl text-white">
          <i class="fas fa-circle-check"></i>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wider text-soft-text">Company Status</p>
        <div class="mt-2 flex items-center gap-2">
          <span class="inline-flex h-2 w-2 animate-pulse rounded-full bg-btn-green"></span>
          <p class="text-base font-bold text-primary">Active</p>
        </div>
      </div>

      <div class="rounded-2xl border-t-4 border-accent bg-light-gray p-6 shadow-soft">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-xl text-white">
          <i class="fas fa-building"></i>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wider text-soft-text">Company Type</p>
        <p class="mt-2 text-base font-bold leading-relaxed text-primary">
          Private Limited Company
        </p>
      </div>

      <div class="rounded-2xl border-t-4 border-accent bg-light-gray p-6 shadow-soft">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-xl text-white">
          <i class="fas fa-calendar-day"></i>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wider text-soft-text">Incorporated On</p>
        <p class="mt-2 text-base font-bold leading-relaxed text-primary">
          29 September 2023
        </p>
      </div>
    </div>
  </div>
</section>

<section class="flex justify-center bg-light-gray py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="relative mb-6 inline-block text-3xl font-bold text-primary md:text-4xl">
          Our Story
          <span class="absolute -bottom-3 left-0 h-[5px] w-[100px] rounded bg-accent"></span>
        </h2>
        <p class="mt-8 text-base leading-relaxed text-soft-text md:text-lg">
          ANZARA GLOBAL LTD was incorporated in the United Kingdom on 29 September 2023, with a registered office in London. We bring together engineers, designers and operators across Bangladesh, Australia and the UK to build software that businesses actually want to keep using.
        </p>
        <p class="mt-4 text-base leading-relaxed text-soft-text md:text-lg">
          Our model is simple: small, senior teams, clear scope, transparent pricing, and a relentless focus on shipping. From a single contact-form enquiry to a multi-year engagement, the same people who plan the work also build it and stand behind it.
        </p>
      </div>

      <div class="rounded-2xl bg-gradient-to-br from-primary to-secondary p-10 text-white shadow-hover">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <i class="fas fa-bullseye mt-1 text-2xl text-accent"></i>
            <div>
              <h4 class="font-bold">Mission</h4>
              <p class="mt-1 text-sm text-white/80">Build software that solves real problems — and stays useful long after launch.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <i class="fas fa-eye mt-1 text-2xl text-accent"></i>
            <div>
              <h4 class="font-bold">Vision</h4>
              <p class="mt-1 text-sm text-white/80">Be the partner businesses call when they need software that works the way it was promised.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <i class="fas fa-handshake mt-1 text-2xl text-accent"></i>
            <div>
              <h4 class="font-bold">Values</h4>
              <p class="mt-1 text-sm text-white/80">Honesty about scope, clarity in communication, and quality you can verify.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%= render "shared/service_cta" %>
