<section class="flex justify-center bg-white py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[360px_1fr]">
      <aside class="rounded-2xl bg-gradient-to-br from-primary to-secondary p-8 text-white">

      </aside>

      <div class="rounded-2xl border border-gray-100 bg-light-gray p-8 md:p-10">
        <h2 class="mb-2 text-2xl font-bold text-primary md:text-3xl">Tell us about your project</h2>
        <p class="mb-8 text-sm text-soft-text">
          Share a few details and we'll match you with the right team. All fields marked <span class="text-red-500">*</span> are required.
        </p>

        <%= form_with url: start_project_path, id: "contact-page-form", local: false,
                      html: { novalidate: true }, data: { controller: "contact-form" } do |form| %>
          <%= hidden_field_tag :current_page, request.original_url %>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
              <label for="contact_list_first_name" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">First Name <span class="text-red-500">*</span></label>
              <%= form.text_field :first_name, name: "contact_list[first_name]", id: "contact_list_first_name", required: true,
                                  class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
              <div class="error-message mt-1 hidden text-xs text-red-500"></div>
            </div>
            <div>
              <label for="contact_list_last_name" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">Last Name <span class="text-red-500">*</span></label>
              <%= form.text_field :last_name, name: "contact_list[last_name]", id: "contact_list_last_name", required: true,
                                  class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
              <div class="error-message mt-1 hidden text-xs text-red-500"></div>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">Company</label>
              <%= form.text_field :company_name, name: "contact_list[company_name]",
                                  class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
              <div class="error-message mt-1 hidden text-xs text-red-500"></div>
            </div>
            <div>
              <label for="contact_list_email" class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">Email <span class="text-red-500">*</span></label>
              <%= form.email_field :email, name: "contact_list[email]", id: "contact_list_email", required: true,
                                   class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
              <div class="error-message mt-1 hidden text-xs text-red-500"></div>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">Service</label>
              <%= form.select :service,
                              ["Custom Software", "Desktop Application", "Mobile App", "Gen AI", "Web Development", "Designing", "Business Automation"],
                              { prompt: "Select a service" },
                              name: "contact_list[service]",
                              class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
              <div class="error-message mt-1 hidden text-xs text-red-500"></div>
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">Budget</label>
              <%= form.select :budget,
                              ["Consultation Free", "$1K-$5K", "$5K-$10K", "$10K+"],
                              { prompt: "Select a budget" },
                              name: "contact_list[budget]",
                              class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
              <div class="error-message mt-1 hidden text-xs text-red-500"></div>
            </div>
          </div>

          <div class="mt-5">
            <label class="mb-1 block text-xs font-semibold uppercase tracking-wider text-soft-text">Tell us more about your idea</label>
            <%= form.text_area :message, name: "contact_list[message]", rows: 5,
                               placeholder: "Project goals, timeline, anything we should know…",
                               class: "w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm text-primary outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20" %>
            <div class="error-message mt-1 hidden text-xs text-red-500"></div>
          </div>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
            <p class="text-xs text-soft-text">We'll never share your details. <i class="fas fa-lock"></i></p>
            <span class="inline-block cursor-pointer rounded-md bg-btn-green px-8 py-3 text-sm font-bold text-white transition hover:scale-[1.02]"
                  data-action="click->contact-form#validateAndSubmit">
              Send Message
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="flex justify-center bg-light-gray py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="mb-14 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-primary md:text-4xl">
        Visit Our Offices
        <span class="absolute -bottom-3 left-1/2 h-[5px] w-[100px] -translate-x-1/2 rounded bg-accent"></span>
      </h2>
      <p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed text-soft-text md:text-lg">
        Three offices, one team. Drop by, or send a courier — we're easy to find.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <%
        offices = [
          # { country: "Bangladesh", flag: "🇧🇩",
          #   address_html: "4th Floor, House: 512, Road: 07,<br>Avenue: 03, Mirpur DOHS,<br>Pallabi, Dhaka 1216" },
          # { country: "Australia", flag: "🇦🇺",
          #   address_html: "Suite 523,<br>368 Sussex Street Sydney,<br>New South Wales 2000" },
          { country: "United Kingdom", flag: "🇬🇧",
            address_html: "Level 39, One Canada Square,<br>Canary Wharf London E14 5AB,<br>United Kingdom" }
        ]
      %>
      <% offices.each do |o| %>
        <div class="rounded-2xl border-t-4 border-accent bg-white p-8 shadow-soft transition hover:-translate-y-1 hover:shadow-hover">
          <div class="mb-4 flex items-center gap-3">
            <span class="text-3xl"><%= o[:flag] %></span>
            <h3 class="text-xl font-bold text-primary"><%= o[:country] %></h3>
          </div>
          <p class="text-base leading-relaxed text-soft-text"><%= o[:address_html].html_safe %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="flex justify-center bg-white py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="mb-14 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-primary md:text-4xl">
        What Happens Next?
        <span class="absolute -bottom-3 left-1/2 h-[5px] w-[100px] -translate-x-1/2 rounded bg-accent"></span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <% [
        ["01", "We Read Your Message", "A real person reviews your enquiry and figures out the right team to bring on the call."],
        ["02", "We Schedule a Call", "Within one business day we'll reply with available time slots — no sales pitch, just a conversation."],
        ["03", "We Map a Plan", "We share an outline, rough budget and a recommended next step — even if that step isn't with us."]
      ].each do |num, title, copy| %>
        <div class="relative rounded-2xl bg-light-gray p-8">
          <div class="mb-3 text-4xl font-extrabold text-accent"><%= num %></div>
          <h4 class="mb-2 text-lg font-bold text-primary"><%= title %></h4>
          <p class="text-sm leading-relaxed text-soft-text"><%= copy %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/cal_com" %>
