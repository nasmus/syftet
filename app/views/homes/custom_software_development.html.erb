<section class="flex justify-center bg-light-gray py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="mb-14 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-primary md:text-4xl">
        OUR APPROACH
        <span class="absolute -bottom-3 left-1/2 h-[5px] w-[100px] -translate-x-1/2 rounded bg-accent"></span>
      </h2>
      <p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed text-soft-text md:text-lg">
        We are fully committed to bring out the best possible design with regular communication with our clients. We welcome the collaboration from our client. We prioritise in regular communication, instructions given by the client and rendering the best output. We always remain transparent to our clients and value their projects.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <%
        approach = [
          { icon: "fas fa-shield-halved", title: "Quality",
            copy: "We believe in quality. Our team of experts employs manual QA and QA applications in order to develop top quality custom software solutions for our clients." },
          { icon: "fas fa-route", title: "Low-Risk Agile Methodology",
            copy: "Our experience with latest technology enables us to develop risk-free enterprise solutions for our clients. The strategy and Methodology we follow are quite unique and based on success. We are open to adapt to any changes and requirements demanded by clients to avert any complexity." },
          { icon: "fas fa-magnifying-glass-chart", title: "Deep Analysis",
            copy: "Our team of business Analysts inspects your business and requirements to a great extent before deciding and mapping the final project. We focus on building your entire ecosystem with zero flaws." },
          { icon: "fas fa-lock", title: "Intellectual Property Security",
            copy: "We acknowledge that your idea is the core part of your project and it is unique, therefore should be safeguarded from all malware and fake claims. Our process and legal documentations are created to ensure the complete ownership and rights of all the codebase and development assets." }
        ]
      %>
      <% approach.each do |a| %>
        <div class="flex gap-5 rounded-2xl bg-white p-6 shadow-soft">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-btn-green text-2xl text-white">
            <i class="<%= a[:icon] %>"></i>
          </div>
          <div>
            <h3 class="mb-2 text-lg font-bold text-primary"><%= a[:title] %></h3>
            <p class="text-sm leading-relaxed text-soft-text"><%= a[:copy] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="flex justify-center bg-white py-20">
  <div class="custom-wrapper px-20 max-[1104px]:px-8 max-[768px]:px-4">
    <div class="mb-14 text-center">
      <h2 class="relative inline-block text-3xl font-bold text-primary md:text-4xl">
        WHAT WE OFFER
        <span class="absolute -bottom-3 left-1/2 h-[5px] w-[100px] -translate-x-1/2 rounded bg-accent"></span>
      </h2>
      <p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed text-soft-text md:text-lg">
        We understand that existing off-the-shelf products may not address the full needs of your company and smooth workflow is vital for your business success. An upgraded version of your current software can deal with such problems. Considering this fact, we offer customized software solutions, which are also cost-effective,for our clients.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      <%
        offers = [
          { icon: "fas fa-coins", title: "Cost Effectiveness",
            copy: "You pay us only once and there is no hidden charge for our support. As soon as you become our clients, you never need to worry about license fees or sharing revenue with anyone. We cover everything for you." },
          { icon: "fas fa-headset", title: "Quick and Responsive Support",
            copy: "Our team of experts are very quick to respond to your query and deal with any problems you face with your enterprise solution. We value your time and business and so our team fixes any issues as soon as possible" },
          { icon: "fas fa-wand-magic-sparkles", title: "New Features and Functionality",
            copy: "We understand that you have some ideas and want some features to be included in your solutions and so we customize your tool according to your demand and requirement. You get exactly what you need in order to boost the functionality of your business process." },
          { icon: "fas fa-tags", title: "Reasonable Development Cost",
            copy: "Ultimately most clients look for opportunities to build their enterprise solution with an affordable fee and we understand this. Our product development cost is much lower than what is available on the market. We implement, integrate and develop a new product with an absolutely reasonable fee that you can, ofcourse, compare with other software development companies in United Kingdom." }
        ]
      %>
      <% offers.each do |o| %>
        <div class="rounded-2xl border-t-4 border-accent bg-light-gray p-6 transition hover:-translate-y-1 hover:shadow-hover">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary text-2xl text-white">
            <i class="<%= o[:icon] %>"></i>
          </div>
          <h3 class="mb-2 text-lg font-bold text-primary"><%= o[:title] %></h3>
          <p class="text-sm leading-relaxed text-soft-text"><%= o[:copy] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/service_cta" %>
